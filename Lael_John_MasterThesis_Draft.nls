
\begin{thenomenclature} 
\nomgroup{A}
  \item [{$[n]$}]\begingroup The set $\{1, 2, \ldots, n\}$, (see \Cref{defn:tensorformat})\nomeqref {2.0}\nompageref{6}
  \item [{$\field$}]\begingroup A general field, in this thesis either $\reals$ or $\complex$ unless specified\nomeqref {1.0}\nompageref{1}
  \item [{$\field[x_1, \ldots, x_n]_d$}]\begingroup Subring of polynomial ring in $n$ variables over $\field$, consisting of polynomials of fixed degree $d$\nomeqref {2.6}\nompageref{10}
  \item [{$\sigma$}]\begingroup A permutation of a finite collection of elements (the length of the collection is specified in context)\nomeqref {2.1}\nompageref{8}
\nomgroup{B}
  \item [{$\langle v_i \rangle_{i=1}^n$}]\begingroup The linear span of $n$ vectors\nomeqref {2.8}\nompageref{14}
  \item [{$\mathcal{L}_i(T)$}]\begingroup The $i$-th slice space generated by slices of $T$ (see \Cref{defn:slicespace})\nomeqref {2.10}\nompageref{15}
  \item [{$S^d(\field^n)$}]\begingroup Symmetric tensors (forms) of order $d$ over $\field^n$\nomeqref {2.4}\nompageref{9}
  \item [{$V_i$}]\begingroup A vector space over $\field$ having dimension $n_i$\nomeqref {2.0}\nompageref{5}
  \item [{$V_i^*$}]\begingroup The dual vector space to $V_i$\nomeqref {2.0}\nompageref{5}
  \item [{$V_{\hat{i}}$}]\begingroup The tensor product of vector spaces excluding $V_i$, defined as $V_1 \otimes \cdots \otimes V_{i-1} \otimes V_{i+1} \otimes \cdots \otimes V_d$\nomeqref {2.1}\nompageref{6}
\nomgroup{C}
  \item [{$\mathbf{\alpha}$}]\begingroup A vector of non-negative integers $(a_1, \ldots, a_n)$\nomeqref {2.6}\nompageref{10}
  \item [{$\mathbf{x^{\alpha}}$}]\begingroup $\prod_{i=1}^{n} x_i^{a_i}$ where $n$ is taken from context\nomeqref {2.6}\nompageref{10}
  \item [{$\mathbf{x}$}]\begingroup A vector of indeterminates $(x_1, \ldots, x_n)$\nomeqref {2.6}\nompageref{10}
  \item [{$e_{i,j}$}]\begingroup The $j$-th standard ordered basis vector in $V_i$. The $i$ may not be dropped if it is clear from context\nomeqref {2.0}\nompageref{5}
  \item [{$v(k)$}]\begingroup The $k$th entry in a vector $v$\nomeqref {2.0}\nompageref{5}
  \item [{$v_i^k$}]\begingroup The $k$-th vector lying in $V_i$\nomeqref {2.1}\nompageref{7}
\nomgroup{D}
  \item [{$T(k_1,\ldots, k_d)$}]\begingroup The element located at the position $(k_1, \ldots, k_d)$ in a tensor $T$\nomeqref {2.0}\nompageref{5}
  \item [{$T^i_j$}]\begingroup The $j$-th slice along the $i$-th mode of a tensor $T$ (see \Cref{defn:tensorslicing})\nomeqref {2.8}\nompageref{13}
  \item [{$T^{\otimes d}$}]\begingroup The tensor product of $T$ with itself $d$ times, $\underbrace{T \otimes T \otimes \cdots \otimes T}_{\text{$d$ times}}$\nomeqref {1.0}\nompageref{2}
\nomgroup{E}
  \item [{$\mathcal{S}(T)$}]\begingroup The symmetrisation operator (see \Cref{defn:symmetrisationoperator}) acting on a tensor $T$\nomeqref {2.3}\nompageref{8}
  \item [{$S^i_j(T)$}]\begingroup The mapping that selects the $j$-th slice along the $i$-th mode of a tensor $T$ (see \Cref{defn:slicingoperator})\nomeqref {2.8}\nompageref{13}
\nomgroup{F}
  \item [{$\rank(T)$}]\begingroup The rank of a tensor $T$\nomeqref {2.1}\nompageref{7}
  \item [{$\srank(T)$}]\begingroup The symmetric rank of a symmetric tensor $T$\nomeqref {2.1}\nompageref{7}

\end{thenomenclature}
